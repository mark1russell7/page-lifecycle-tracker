{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "noEmit": true,
    "rootDir": "${configDir}"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "build/**/*"],
  "exclude": ["node_modules", "dist"]
}
