{
  "$schema": "https://json.schemastore.org/package",
  "name": "page-lifecycle-tracker",
  "version": "0.1.0",
  "description": "The Page Lifecycle state of a web page (active, passive, hidden, frozen, terminated) for monitoring and telemetry libraries: one shared tracker for the page, observers before exporters, back/forward cache restores, and marks.",
  "keywords": [
    "page-lifecycle",
    "page lifecycle api",
    "visibilitychange",
    "pagehide",
    "pageshow",
    "bfcache",
    "back-forward-cache",
    "freeze",
    "resume",
    "web-vitals",
    "opentelemetry",
    "rum",
    "real-user-monitoring",
    "telemetry",
    "browser"
  ],
  "license": "MIT",
  "author": "Mark Russell",
  "homepage": "https://mark1russell7.github.io/page-lifecycle-tracker/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mark1russell7/page-lifecycle-tracker.git",
    "directory": "packages/page-lifecycle-tracker"
  },
  "bugs": {
    "url": "https://github.com/mark1russell7/page-lifecycle-tracker/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/test-fakes.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@mark1russell7/cue": "github:mark1russell7/cue",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
