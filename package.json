{
  "$schema": "https://json.schemastore.org/package",
  "name": "page-lifecycle-tracker-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "package": "template package",
    "template": "template repo",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint:ste": "ste-lint",
    "check:api": "api-report check",
    "check:conventions": "conventions check"
  },
  "sitePages": {
    "bareErrors": "fail"
  },
  "devDependencies": {
    "@mark1russell7/api-report": "^0.5.0",
    "@mark1russell7/conventions": "^0.53.2",
    "@mark1russell7/cue": "^2.1.2",
    "@mark1russell7/ste-lint": "^0.6.0",
    "@mark1russell7/template-cli": "^0.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "conventions": {
    "rules": {
      "no-console": {
        "baseline": 0,
        "failFrom": "2027-01-20",
        "reason": "The census of 2026-11-25 found no console call. A new call fails at once, and each call fails from 2027-01-20."
      },
      "playwright-install": {
        "ignore": [
          ".github/workflows/ci.yml"
        ],
        "reason": "The shared CI (reusable-ci.yml) has no input for the action setup-playwright, so its setup line installs Chromium for the browser tests of the site. It ends when the shared CI gets that input."
      }
    }
  }
}
